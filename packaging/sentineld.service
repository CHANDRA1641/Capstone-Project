[Unit]
Description=Sentinel sensor telemetry daemon
After=network.target

[Service]
Type=simple
# Foreground (no --daemon): systemd supervises the process directly.
ExecStart=/usr/local/sbin/sentineld --source sim --listen 127.0.0.1:9090 --period 100
# Real hardware: --source device --device /dev/sentinel0
Restart=on-failure
RestartSec=2
DynamicUser=yes
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
# For --source device, allow the node:
#DeviceAllow=/dev/sentinel0 r

[Install]
WantedBy=multi-user.target
